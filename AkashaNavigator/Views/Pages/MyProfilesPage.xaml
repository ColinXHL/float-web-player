<UserControl x:Class="AkashaNavigator.Views.Pages.MyProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AkashaNavigator.Models.Profile;assembly=AkashaNavigator"
             Background="Transparent"
             Cursor="Arrow">
    
    <UserControl.Resources>
        <!-- 已移除本地资源定义，使用全局样式：
             - BoolToVisibilityConverter -> 全局 Converters.xaml
             - ZeroToVisibleConverter -> 全局 Converters.xaml
             - LocalPrimaryButtonStyle -> 全局 PrimaryActionButtonStyle
             - LocalDangerButtonStyle -> 全局 DangerActionButtonStyle
             - LocalWarningButtonStyle -> 全局 WarningActionButtonStyle -->

        <!-- 本地切换开关样式 (添加 Cursor) - 保留，因为是对全局样式的扩展 -->
        <Style x:Key="LocalToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="我的 Profile" FontSize="18" FontWeight="SemiBold" 
                       Foreground="White" VerticalAlignment="Center"/>
        </Grid>

        <!-- Profile 选择器 + 操作按钮 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="查看 Profile:" Foreground="#AAA" FontSize="13" 
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="ProfileSelector" Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                      ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      MinWidth="200">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:ProfileSelectorModel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#0078D4" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="当前使用" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Profile 操作按钮：设为当前、编辑、删除 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="设为当前" Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding SetCurrentCommand}" ToolTip="将此 Profile 设为当前使用"
                        Visibility="{Binding SetCurrentButtonVisibility}"/>
                <Button Content="✏️" Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding EditProfileCommand}" ToolTip="编辑 Profile" Margin="4,0,0,0"/>
                <Button Content="🗑️" Style="{StaticResource DangerActionButtonStyle}"
                        Command="{Binding DeleteProfileCommand}" ToolTip="删除 Profile" Margin="4,0,0,0"/>
            </StackPanel>
            <!-- 新建 Profile 按钮 -->
            <Button Grid.Column="3" Content="➕ 新建" Style="{StaticResource PrimaryActionButtonStyle}"
                    Command="{Binding NewProfileCommand}" Margin="12,0,0,0"/>
            <!-- 导入导出按钮 -->
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button Content="📥 导入" Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                <Button Content="📤 导出" Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Profile 详情区域 -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource DarkScrollViewer}" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfileDetailPanel">
                <!-- 缺失插件警告 -->
                <Border Style="{StaticResource WarningTagStyle}"
                        Visibility="{Binding MissingWarningVisibility}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="⚠" Foreground="#FBBF24" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding MissingWarningText}" Foreground="#FBBF24" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1"
                                Content="{Binding InstallMissingButtonText}"
                                Style="{StaticResource WarningActionButtonStyle}"
                                Command="{Binding InstallMissingCommand}"/>
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="22,10,0,0"
                                    Visibility="{Binding IsPluginInstallBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Height="5"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding PluginInstallProgress}"
                                         IsIndeterminate="{Binding IsPluginInstallProgressIndeterminate}"
                                         Foreground="{StaticResource WarningBrush}"
                                         Background="{StaticResource SurfaceDarkerBrush}"/>
                            <TextBlock Text="{Binding PluginInstallStatusText}"
                                       Margin="0,5,0,0"
                                       Foreground="#FBBF24"
                                       FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 插件清单标题 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="插件清单" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PluginCountText}" Foreground="#666" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="➕ 添加插件"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding AddPluginCommand}"/>
                </Grid>

                <!-- 无插件提示 -->
                <TextBlock Text="此 Profile 没有添加任何插件"
                           Foreground="#666" FontSize="13" Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasNoPlugins, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 插件列表 -->
                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ProfilePluginModel">
                            <Border Style="{StaticResource InnerPluginCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 启用/禁用开关 -->
                                    <CheckBox Grid.Column="0" Style="{StaticResource LocalToggleSwitchStyle}"
                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Checked="PluginToggle_Changed" Unchecked="PluginToggle_Changed"
                                              Tag="{Binding PluginId}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- 插件信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔌" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                                                       Foreground="#666" FontSize="11"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <!-- 状态标签 -->
                                            <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Style="{Binding StatusTagStyle}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusColor}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="11"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="400" Margin="0,4,0,0"
                                                   Visibility="{Binding HasDescriptionVisibility}"/>
                                    </StackPanel>

                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 安装按钮（仅缺失时显示） -->
                                        <Button Content="安装" Style="{StaticResource PrimaryActionButtonStyle}"
                                                Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding PluginId}"
                                                Visibility="{Binding InstallButtonVisibility}" Margin="0,0,8,0"/>
                                        <!-- 添加按钮（仅从原始列表移除的插件显示） -->
                                        <Button Content="添加" Style="{StaticResource PrimaryActionButtonStyle}"
                                                Command="{Binding DataContext.AddBackPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding PluginId}"
                                                Visibility="{Binding AddBackButtonVisibility}" Margin="0,0,8,0"/>
                                        <!-- 设置按钮（仅已安装时显示） -->
                                        <Button Content="⚙️ 设置" Style="{StaticResource ActionButtonStyle}"
                                                Command="{Binding DataContext.OpenPluginSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding PluginId}"
                                                ToolTip="插件设置"
                                                Visibility="{Binding SettingsButtonVisibility}" Margin="0,0,8,0"/>
                                        <!-- 移除按钮 -->
                                        <Button Content="{Binding RemoveButtonText}" Style="{StaticResource DangerActionButtonStyle}"
                                                Command="{Binding DataContext.RemovePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding PluginId}"
                                                Visibility="{Binding RemoveButtonVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
